{
  "name": "lms-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "node apps/server/build/server.js",
    "mobile": "npm run dev --workspace=mobile",
    "admin": "npm run dev --workspace=admin",
    "server": "npm run dev --workspace=server",
    "clean": "turbo clean && rm -rf node_modules **/build **/.next **/dist"
  },
  "devDependencies": {
    "turbo": "^2.1.2",
    "concurrently": "^8.2.2",
    "typescript": "^5.6.2"
  }
}