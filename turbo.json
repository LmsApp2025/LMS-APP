{
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "build/**",
        "dist/**",
        ".next/standalone/**",
        ".next/server/**",
        ".next/static/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}